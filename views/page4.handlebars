<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>Page 4</title>
</head>
<body>
  <h1>All Dogs</h1>

  <a href="/">Home</a>
  <a href="/page3">Page 3</a>

  {{#if dogs}}
    <ul>
      {{#each dogs}}
        <li>{{this.name}} is a {{this.breed}}, age {{this.age}}</li>
      {{/each}}
    </ul>
  {{else}}
    <p>No dogs yet.</p>
  {{/if}}
</body>
</html>